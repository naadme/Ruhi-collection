# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Only `VITE_*` variables reach the browser bundle. Anything without that
# prefix stays on the server, and Vite will not expose it.

# --- Supabase (Project Settings → API) -------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Razorpay public key (Dashboard → Account & Settings → API Keys) -------
# Test keys start with `rzp_test_`, live keys with `rzp_live_`.
# This one is safe to expose: it identifies the account and cannot authorise
# anything on its own. Leave it empty to hide "Online payment" at checkout.
VITE_RAZORPAY_KEY_ID=

# --- Razorpay server-side credentials (optional, local development only) -----
# NEVER prefixed with VITE_ — a VITE_ prefix is what ships a value to the
# browser, so these two must keep their plain names in whatever file they live.
#
#   RAZORPAY_KEY_ID     same value as VITE_RAZORPAY_KEY_ID, read server-side
#   RAZORPAY_KEY_SECRET the Key Secret; used only for Basic auth + HMAC signing
#
# The deployed project reads them from Edge Function secrets, not from a file:
#
#   npx supabase secrets set \
#     RAZORPAY_KEY_ID=… RAZORPAY_KEY_SECRET=… RAZORPAY_WEBHOOK_SECRET=… \
#     --project-ref <your-project-ref>
#
# Putting RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET in your local, gitignored
# `.env` is safe and lets `npx supabase functions serve --env-file .env` run
# the functions locally. `.env.example` stays copy-safe because it is committed.
# See README.md.
