# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Only `VITE_*` variables reach the browser bundle. Anything without that
# prefix stays on the server, and Vite will not expose it.

# --- Supabase (Project Settings → API) -------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Razorpay public key (Dashboard → Account & Settings → API Keys) -------
# Test keys start with `rzp_test_`, live keys with `rzp_live_`.
# This one is safe to expose: it identifies the account and cannot authorise
# anything on its own. Leave it empty to hide "Online payment" at checkout.
VITE_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------------------
# NOT environment variables, NOT in this file, NEVER prefixed with VITE_:
#
#   RAZORPAY_KEY_ID         → supabase secrets set RAZORPAY_KEY_ID=…
#   RAZORPAY_KEY_SECRET     → supabase secrets set RAZORPAY_KEY_SECRET=…
#   RAZORPAY_WEBHOOK_SECRET → supabase secrets set RAZORPAY_WEBHOOK_SECRET=…
#
# The first is the same value as VITE_RAZORPAY_KEY_ID, kept server-side too so
# the Edge Functions never need to read the bundle. The other two are secrets
# and exist only inside the Edge Functions. See README.md.
# ---------------------------------------------------------------------------
